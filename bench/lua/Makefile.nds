# Lua benchmark ROMs for DS: luabench64.nds (Lua's default 64-bit int/double) and
# luabench32.nds (LUA_32BITS: 32-bit int/float).
ifeq ($(strip $(DEVKITARM)),)
$(error DEVKITARM is not set; use the devkitpro/devkitarm container)
endif

GAME_TITLE     := luabench
GAME_SUBTITLE1 := Lua benchmark
GAME_SUBTITLE2 := github.com/gavinhsmith/hangout64
LIBPATHS := -L$(DEVKITPRO)/libnds/lib

include $(DEVKITARM)/ds_rules

BUILD   := build/nds
PYTHON  ?= python3
LUA32   := $(BUILD)/lua32
include lua.mk
OBJS     = $(addprefix $(BUILD)/$(1)/,bench.o main_nds.o $(LUA_SRC:.c=.o))
ARCH    := -march=armv5te -mtune=arm946e-s
CFLAGS  := -O2 -Wall $(ARCH) -DARM9 $(_EXTRADEFS) -I$(LIBNDS)/include -I.
LD      := $(CC)
LDFLAGS := -specs=ds_arm9.specs $(ARCH)
LIBS    := -lnds9 -lm

all: luabench64.nds luabench32.nds

bench_lua.h: bench.lua embed.py
	$(PYTHON) embed.py bench.lua bench_lua > $@

$(BUILD)/64/%.o: $(LUA)/%.c
	@mkdir -p $(dir $@)
	$(CC) $(CFLAGS) -c $< -o $@
$(BUILD)/32/%.o: $(LUA32)/%.c | $(LUA32_HDR)
	@mkdir -p $(dir $@)
	$(CC) $(CFLAGS) -c $< -o $@
$(BUILD)/64/%.o: %.c bench_lua.h
	@mkdir -p $(dir $@)
	$(CC) $(CFLAGS) -I$(LUA) -c $< -o $@
$(BUILD)/32/%.o: %.c bench_lua.h | $(LUA32_HDR)
	@mkdir -p $(dir $@)
	$(CC) $(CFLAGS) -I$(LUA32) -c $< -o $@

# ds_rules' %.elf rule links $(OFILES).
luabench64.nds: luabench64.elf
luabench32.nds: luabench32.elf
luabench64.elf: OFILES = $(call OBJS,64)
luabench64.elf: $(call OBJS,64)
luabench32.elf: OFILES = $(call OBJS,32)
luabench32.elf: $(call OBJS,32)

.PHONY: all
